MONGO_URI=mongodb://localhost:27017/paint-saas
PORT=7690
NODE_ENV=development

# Must match server PDF_SERVICE_SECRET (min 32 chars)
PDF_SERVICE_SECRET=change-me-use-openssl-rand-hex-32-for-this-value

# AWS S3 (same bucket as main API)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=paintpwa-pdf-prod-791070062163-ap-south-1-an

# RabbitMQ — must match server/.env
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=paint.exchange
BILL_PDF_QUEUE=paint.bill.pdf.queue
CASHMEMO_PDF_QUEUE=paint.cashmemo.pdf.queue

# CORS — main PaintPWA client origin
PAINT_FRONTEND_BASE_URL=http://localhost:5173
