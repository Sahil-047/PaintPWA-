{
  "name": "paint-saas",
  "private": true,
  "version": "2.0.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "server",
    "client",
    "pdf-service"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "deploy:docker": "bash scripts/deploy-docker.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
