PORT=5000
MONGODB_URI=mongodb://localhost:27017/paint-saas
JWT_SECRET=change-this-in-production-use-a-long-random-string
JWT_EXPIRE=7d
NODE_ENV=development
SUPERADMIN_EMAIL=admin@paintappstore.in
SUPERADMIN_PASSWORD=ChangeThisSuperAdminPassword1
BOOTSTRAP_SECRET=change-this-bootstrap-secret-min-8-chars

# PDF storage: local | s3
PDF_STORAGE=local
AWS_REGION=ap-south-1
AWS_S3_PDF_BUCKET=paintpwa-pdf-prod-791070062163-ap-south-1-an
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RabbitMQ (publish from API; pdf-service consumes)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=paint.exchange
BILL_PDF_QUEUE=paint.bill.pdf.queue
CASHMEMO_PDF_QUEUE=paint.cashmemo.pdf.queue
