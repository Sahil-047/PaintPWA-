{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsc && node dist/server.js\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "migrate:products": "node scripts/migrate-products.mjs",
    "migrate:products:dry": "node scripts/migrate-products.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@paint-saas/shared-types": "*",
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.2"
  }
}
