# Copy to docker/.env.production on the VPS and fill all values.
# docker compose -f docker-compose.prod.yml --env-file docker/.env.production up -d --build

# --- Host port mappings (nginx on host proxies to these) ---
API_HOST_PORT=5001
CLIENT_HOST_PORT=8080
MARKETING_HOST_PORT=3000

# --- Public URLs ---
PAINT_FRONTEND_BASE_URL=https://app.paintappstore.in
NEXT_PUBLIC_APP_URL=https://app.paintappstore.in
VITE_API_URL=/api

# --- MongoDB (existing Hostinger / VPS Mongo) ---
MONGODB_URI=mongodb://USER:PASSWORD@host:27017/paint-saas?authSource=admin

# --- API (server container reads these via env_file) ---
PORT=5000
JWT_SECRET=change-me-long-random-string-min-16-chars
JWT_EXPIRE=7d
NODE_ENV=production
SUPERADMIN_EMAIL=admin@paintappstore.in
SUPERADMIN_PASSWORD=ChangeThisSuperAdminPassword1
BOOTSTRAP_SECRET=change-me-bootstrap-secret

# Shared with API server — must match server PDF_SERVICE_SECRET (min 32 chars)
PDF_SERVICE_SECRET=change-me-use-openssl-rand-hex-32-for-this-value

# --- PDF / S3 ---
PDF_STORAGE=s3
AWS_REGION=ap-south-1
AWS_S3_PDF_BUCKET=paintpwa-pdf-prod-791070062163-ap-south-1-an
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=paintpwa-pdf-prod-791070062163-ap-south-1-an
# Overridden in compose to http://pdf-service:7690 — set only for non-Docker API
# PDF_SERVICE_URL=http://localhost:7690

# --- RabbitMQ (internal Docker network — do NOT use localhost) ---
RABBITMQ_USER=paint
RABBITMQ_PASSWORD=change-me-strong-rabbitmq-password
RABBITMQ_HOST=rabbitmq
# IMPORTANT: do not set RABBITMQ_URL here — it overrides Docker networking if set to localhost.
# The app builds amqp://user:pass@rabbitmq:5672 from the vars above.
RABBITMQ_EXCHANGE=paint.exchange
BILL_PDF_QUEUE=paint.bill.pdf.queue
CASHMEMO_PDF_QUEUE=paint.cashmemo.pdf.queue

# pdf-service uses MONGO_URI — set same as MONGODB_URI (compose overrides at runtime)
